{
  "name": "agent-os",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Agent-native OS scaffold: event-log-first, Task/Flow/Automation/StandingOrder, Agent/Worker split, hybrid fast-path+dreaming memory.",
  "scripts": {
    "build": "tsc -b",
    "demo": "tsc -b && node dist/cli.js demo",
    "chat": "tsc -b && node dist/cli.js chat",
    "cli": "tsc -b && node dist/cli.js",
    "test-live-model": "tsc -b && node dist/test-live-model.js",
    "test-cron": "tsc -b && node dist/test-cron.js",
    "test-eventbus": "tsc -b && node dist/test-eventbus.js",
    "test-webhook": "tsc -b && node dist/test-webhook.js",
    "test-skills-write": "tsc -b && node dist/test-skills-write.js",
    "test-heartbeat": "tsc -b && node dist/test-heartbeat.js",
    "test-subagent": "tsc -b && node dist/test-subagent.js",
    "test-cross-harness-worker": "tsc -b && node dist/test-cross-harness-worker.js",
    "test-memory": "tsc -b && node dist/test-memory.js",
    "test-memory-v2": "tsc -b && node dist/test-memory-v2.js",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
